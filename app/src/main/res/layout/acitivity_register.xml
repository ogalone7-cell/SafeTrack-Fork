<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#131A33"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_watch"
                android:background="@drawable/bg_gold_round"
                android:padding="12dp"
                android:contentDescription="@string/safetrack"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register Guardian &amp; Child Information"
                android:textColor="#D89A3A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Form Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- PARENT SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. GUARDIAN DETAILS"
                android:textColor="#131A33"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Parent Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FULL NAME"
                android:textStyle="bold"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etParentName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:hint="Enter parent full name"
                android:inputType="textPersonName"
                android:padding="16dp"
                android:textColor="@color/input_text_dark"
                android:textColorHint="@color/input_hint_gray"/>

            <!-- Parent Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL ADDRESS"
                android:textStyle="bold"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etParentEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:hint="Enter email address"
                android:inputType="textEmailAddress"
                android:padding="16dp"
                android:textColor="@color/input_text_dark"
                android:textColorHint="@color/input_hint_gray"/>

            <!-- Parent Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE NUMBER"
                android:textStyle="bold"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etParentPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:hint="Enter 10-digit phone number"
                android:inputType="phone"
                android:padding="16dp"
                android:textColor="@color/input_text_dark"
                android:textColorHint="@color/input_hint_gray"/>

            <!-- Parent Age & Gender Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AGE"
                        android:textStyle="bold"
                        android:textColor="#666666"/>

                    <EditText
                        android:id="@+id/etParentAge"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="e.g. 35"
                        android:inputType="number"
                        android:padding="16dp"
                        android:textColor="@color/input_text_dark"
                        android:textColorHint="@color/input_hint_gray"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GENDER"
                        android:textStyle="bold"
                        android:textColor="#666666"/>

                    <Spinner
                        android:id="@+id/spParentGender"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_edittext"
                        android:padding="12dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Parent Relation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RELATION TO CHILD"
                android:textStyle="bold"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etParentRelation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:hint="e.g. Father, Mother, Guardian"
                android:inputType="text"
                android:padding="16dp"
                android:textColor="@color/input_text_dark"
                android:textColorHint="@color/input_hint_gray"/>

            <!-- Parent Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textStyle="bold"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etParentPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_edittext"
                android:hint="Min 5 chars, 1 symbol, 2 numbers"
                android:inputType="textPassword"
                android:padding="16dp"
                android:textColor="@color/input_text_dark"
                android:textColorHint="@color/input_hint_gray"/>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginBottom="24dp"/>

            <!-- CHILD SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. CHILD DETAILS"
                android:textColor="#131A33"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Child Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHILD NAME"
                android:textStyle="bold"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etChildName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edittext"
                android:hint="Enter child full name"
                android:inputType="textPersonName"
                android:padding="16dp"
                android:textColor="@color/input_text_dark"
                android:textColorHint="@color/input_hint_gray"/>

            <!-- Child Age & Gender Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHILD AGE"
                        android:textStyle="bold"
                        android:textColor="#666666"/>

                    <EditText
                        android:id="@+id/etChildAge"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="e.g. 10"
                        android:inputType="number"
                        android:padding="16dp"
                        android:textColor="@color/input_text_dark"
                        android:textColorHint="@color/input_hint_gray"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GENDER"
                        android:textStyle="bold"
                        android:textColor="#666666"/>

                    <Spinner
                        android:id="@+id/spChildGender"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_edittext"
                        android:padding="12dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Child Device No. (Optional) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE NUMBER (OPTIONAL)"
                android:textStyle="bold"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etChildDevice"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_edittext"
                android:hint="Enter SafeTrack device ID (Optional)"
                android:inputType="text"
                android:padding="16dp"
                android:textColor="@color/input_text_dark"
                android:textColorHint="@color/input_hint_gray"/>

            <!-- Register Button -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Register Account"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_gold_button"/>

            <!-- Back to Login -->
            <TextView
                android:id="@+id/txtLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Already have an account? Log In"
                android:textSize="16sp"
                android:textColor="#2F7D6A"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>